---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartFlow from '../components/CartFlow.astro';

const pages = {
  'contacto': { title: 'Contacto', text: 'Escríbenos para recibir asesoría personalizada sobre tu dormitorio ideal.' },
  'sobre-nosotros': { title: 'Sobre nosotros', text: 'En DormyTop combinamos diseño, confort y fabricación a medida para transformar tu descanso.' },
  'preguntas-frecuentes': { title: 'Preguntas frecuentes', text: 'Encuentra información sobre medidas, telas, entregas, garantía y personalización.' },
  'tienda': { title: 'Tienda', text: 'Explora camas, cabeceras, tarimas y colecciones creadas para tu espacio.' },
  'arma-tu-dormitorio': { title: 'Arma tu dormitorio', text: 'Configura una combinación que se adapte a tu habitación y estilo.' },
  'carrito': { title: 'Tu carrito', text: 'Tus productos seleccionados aparecerán aquí.' },
  'finalizar-compra': { title: 'Finalizar compra', text: 'Completa tus datos para confirmar tu pedido de forma segura.' },
  'pagina-no-encontrada': { title: 'Página no encontrada', text: 'La página que buscas no está disponible o fue movida.' },
  'politica-de-privacidad': { title: 'Política de privacidad', text: 'Conoce cómo protegemos y tratamos tus datos personales.' },
  'politica-de-devoluciones-y-reembolsos': { title: 'Política de devoluciones y reembolsos', text: 'Consulta las condiciones aplicables a cambios, devoluciones y reembolsos.' },
  'terminos-y-condiciones': { title: 'Términos y condiciones', text: 'Revisa las condiciones de uso, compra y entrega de DormyTop.' },
  'libro-de-reclamaciones': { title: 'Libro de reclamaciones', text: 'Registra tu reclamo o queja. Te responderemos dentro de los plazos legales aplicables.' },
};
export function getStaticPaths() {
  const pageEntries = [
    ['contacto', 'Contacto', 'Escríbenos para recibir asesoría personalizada sobre tu dormitorio ideal.'],
    ['sobre-nosotros', 'Sobre nosotros', 'En DormyTop combinamos diseño, confort y fabricación a medida para transformar tu descanso.'],
    ['preguntas-frecuentes', 'Preguntas frecuentes', 'Encuentra información sobre medidas, telas, entregas, garantía y personalización.'],
    ['tienda', 'Tienda', 'Explora camas, cabeceras, tarimas y colecciones creadas para tu espacio.'],
    ['arma-tu-dormitorio', 'Arma tu dormitorio', 'Configura una combinación que se adapte a tu habitación y estilo.'],
    ['carrito', 'Tu carrito', 'Tus productos seleccionados aparecerán aquí.'],
    ['finalizar-compra', 'Finalizar compra', 'Completa tus datos para confirmar tu pedido de forma segura.'],
    ['pagina-no-encontrada', 'Página no encontrada', 'La página que buscas no está disponible o fue movida.'],
    ['politica-de-privacidad', 'Política de privacidad', 'Conoce cómo protegemos y tratamos tus datos personales.'],
    ['politica-de-devoluciones-y-reembolsos', 'Política de devoluciones y reembolsos', 'Consulta las condiciones aplicables a cambios, devoluciones y reembolsos.'],
    ['terminos-y-condiciones', 'Términos y condiciones', 'Revisa las condiciones de uso, compra y entrega de DormyTop.'],
    ['libro-de-reclamaciones', 'Libro de reclamaciones', 'Registra tu reclamo o queja. Te responderemos dentro de los plazos legales aplicables.'],
  ];
  return pageEntries.map(([slug, title, text]) => ({ params: { slug }, props: { page: { title, text } } }));
}
const { page } = Astro.props;
const slug = Astro.params.slug;
const faqs = [
  ['¿Cuáles son los tiempos de entrega?', 'Para productos en stock o telas estándar, el despacho se realiza en un plazo de 24 a 48 horas. Para pedidos personalizados —elección de telas especiales de catálogo, medidas a medida o acabados específicos— el tiempo de fabricación es de 3 a 5 días hábiles.'],
  ['¿Realizan envíos a provincias y Lima?', 'Sí, realizamos envíos a todo Lima Metropolitana y Callao con entrega a domicilio. Para envíos a nivel nacional a cualquier provincia del Perú, despachamos a través de agencias de carga de tu preferencia con seguimiento de guía.'],
  ['¿Puedo elegir una tela o color que no esté en la web?', 'Por supuesto. Disponemos de un catálogo digital de más de 30 telas y texturas exclusivas. Puedes contactarnos directamente por WhatsApp para recibir el muestrario completo y coordinar la personalización de tu cama o cabecera.'],
  ['¿Qué métodos de pago aceptan?', 'Aceptamos tarjetas de débito y crédito a través de pasarela segura en la web, así como transferencias directas —BCP y BBVA— y billeteras digitales como Yape y Plin.'],
  ['¿El servicio incluye armado e instalación?', 'Nuestras camas, tarimas y cabeceras están diseñadas con ensambles de fácil instalación. Para entregas dentro de Lima, ofrecemos soporte y coordinación de armado previa confirmación al momento de concretar la compra vía WhatsApp.'],
  ['¿Qué garantía tienen los muebles?', 'Todos nuestros productos cuentan con garantía contra fallas de fabricación en estructuras de madera y confección. Cuidamos cada detalle para garantizar durabilidad, estabilidad y confort en tu descanso.'],
];
---
<BaseLayout title={`${page.title} | DormyTop`}><Header />{slug === 'carrito' ? <CartFlow initialStep={1} /> : slug === 'finalizar-compra' ? <CartFlow initialStep={2} /> : <main class="info-page"><p> DormyTop </p><h1>{page.title}</h1><p class="lead">{page.text}</p>
  {slug === 'preguntas-frecuentes' && <section class="faq-list">{faqs.map(([question, answer], index) => <details open={index === 0}><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}</section>}
  {slug === 'politica-de-devoluciones-y-reembolsos' && <article class="legal-content"><p>Última actualización: Octubre de 2026 · DORMYTOP</p><p>Fabricamos muebles de dormitorio priorizando calidad, durabilidad y confort. Estas son las condiciones aplicables a cambios, devoluciones y reembolsos.</p><h2>1. Condiciones generales para cambios y devoluciones</h2><ul><li>El plazo máximo para comunicar cualquier eventualidad es de hasta siete (7) días calendario posteriores a la entrega.</li><li>La solicitud debe gestionarse por nuestros canales oficiales: WhatsApp (+51 939 624 109) o soporte@dormytop.com.</li><li>Es indispensable adjuntar el comprobante de pago y fotografías o videos nítidos que evidencien el estado del producto.</li><li>El mueble debe estar sin uso, sin manchas ni olores y conservar todos sus accesorios y protecciones.</li></ul><h2>2. Productos personalizados y a medida</h2><ul><li>Los artículos fabricados bajo especificaciones expresas del cliente no proceden por desistimiento o cambio de opinión.</li><li>Incluye camas, tarimas o cabeceras con telas, colores o medidas seleccionadas fuera del stock estándar.</li><li>La cobertura aplica exclusivamente ante fallas estructurales o defectos de fabricación comprobados en taller.</li></ul><h2>3. Transporte, recepción y revisión</h2><ul><li>En Lima y Callao, inspecciona el mueble al momento de la entrega. Cualquier daño de traslado debe reportarse dentro de las primeras 24 horas.</li><li>Para provincias, verifica el estado exterior del bulto en la agencia antes de firmar la conformidad de recepción.</li></ul><h2>4. Procedimiento y tiempos de reembolso</h2><ul><li>Cuando legalmente corresponda una restitución económica, los pagos por transferencia, Yape o Plin se procesan entre 48 y 72 horas hábiles luego de validar el caso.</li><li>Los pagos con tarjeta se solicitan a la pasarela correspondiente; la acreditación depende de la entidad bancaria emisora.</li></ul><h2>Canal de atención y contacto</h2><ul><li>WhatsApp: +51 939 624 109</li><li>Correo: soporte@dormytop.com</li><li>Taller: Av. Central 523, Los Olivos 15306</li></ul></article>}
  {slug === 'politica-de-privacidad' && <article class="legal-content"><p>Última actualización: Octubre de 2026</p><p>En DORMYTOP reconocemos la importancia de proteger la privacidad y los datos personales de nuestros usuarios y clientes. Este documento explica cómo recopilamos, utilizamos, almacenamos y protegemos la información proporcionada al navegar y comprar en nuestra tienda.</p><p>El tratamiento de datos personales cumple con la Ley N.º 29733, Ley de Protección de Datos Personales del Perú, su Reglamento y demás normas aplicables.</p><h2>Responsable del tratamiento</h2><ul><li>Nombre comercial y razón social: DORMYTOP</li><li>RUC: 20613209892</li><li>Domicilio fiscal y taller: Av. Central 523, Los Olivos 15306</li><li>Correo: soporte@dormytop.com · WhatsApp: +51 993 9624 109</li></ul><h2>Datos que recopilamos</h2><ul><li>Identificación y contacto: nombres, documento, correo, teléfono o WhatsApp.</li><li>Envío y facturación: dirección de entrega y datos para comprobantes de pago.</li><li>Datos técnicos: dirección IP, cookies e interacción con el sitio, únicamente para rendimiento y análisis estadístico.</li></ul><p><strong>Aviso de pagos:</strong> DORMYTOP no almacena números de tarjetas, CVV ni claves bancarias. Las transacciones se procesan mediante pasarelas seguras y certificadas.</p><h2>Finalidades del tratamiento</h2><ol><li>Gestionar pedidos, fabricación, despacho y entrega.</li><li>Comunicar el estado del pedido, disponibilidad de telas y atención de consultas.</li><li>Emitir comprobantes electrónicos conforme a SUNAT.</li><li>Enviar novedades y promociones únicamente con consentimiento expreso.</li><li>Atender garantías, devoluciones y reclamos.</li></ol><h2>Consentimiento y terceros</h2><p>Al registrar datos y aceptar esta política, el usuario otorga consentimiento libre, previo, expreso, informado e inequívoco. No vendemos, cedemos ni alquilamos información personal. Solo la compartimos con transportistas, pasarelas de pago, proveedores técnicos indispensables o autoridades ante mandato legal.</p><h2>Seguridad y derechos ARCO</h2><p>La información se almacena en el banco de datos «Clientes y Usuarios Web». Aplicamos medidas técnicas, organizativas y legales para prevenir pérdida, alteración o acceso no autorizado.</p><p>Puede solicitar acceso, actualización, corrección, cancelación o revocación del consentimiento escribiendo a soporte@dormytop.com e indicando nombre completo, documento de identidad y el derecho que desea ejercer.</p><h2>Cookies y actualizaciones</h2><p>Usamos cookies esenciales para el carrito, sesión y rendimiento, además de cookies analíticas no identificatorias. Esta política podrá actualizarse por cambios operativos o regulatorios; la nueva versión se publicará en esta página.</p></article>}
  {slug === 'libro-de-reclamaciones' && <section class="complaints"><div class="complaint-company"><p><strong>RUC:</strong> 20613209892</p><p><strong>Dirección:</strong> Av. Central 523, Los Olivos 15306</p></div><form class="complaint-form" method="post"><fieldset><legend>Datos personales</legend><div class="form-grid two"><label>Correo <b>*</b><input required type="email" name="email" placeholder="Correo" /></label><label>Número <b>*</b><input required type="tel" name="telefono" placeholder="Número" /></label><label>Nombre <b>*</b><input required name="nombre" placeholder="Nombre" /></label><label>Apellido <b>*</b><input required name="apellido" placeholder="Apellido" /></label><label>Tipo de documento <b>*</b><select required name="tipo-documento"><option value="">— Seleccione —</option><option>DNI</option><option>CE</option><option>RUC</option></select></label><label>Número de documento <b>*</b><input required name="documento" /></label></div><div class="form-grid three"><label>Departamento <b>*</b><input required name="departamento" /></label><label>Provincia <b>*</b><input required name="provincia" /></label><label>Distrito <b>*</b><input required name="distrito" /></label></div><label>Dirección <b>*</b><input required name="direccion" /></label></fieldset><fieldset><legend>Detalles del reclamo</legend><div class="form-grid two"><label>Tipo de reclamo <b>*</b><select required name="tipo-reclamo"><option value="">— Seleccione —</option><option>Reclamo</option><option>Queja</option></select></label><label>Tipo de bien <b>*</b><select required name="tipo-bien"><option value="">— Seleccione —</option><option>Producto</option><option>Servicio</option></select></label></div><label>Descripción <b>*</b><textarea required name="descripcion" rows="5"></textarea></label><label>Detalle <b>*</b><textarea required name="detalle" rows="5"></textarea></label><label>Pedido <b>*</b><textarea required name="pedido" rows="5"></textarea></label></fieldset><label class="consent"><input required type="checkbox" /> He leído los <a href="/terminos-y-condiciones/">Términos y Condiciones</a> y la <a href="/politica-de-privacidad/">Política de privacidad</a>.</label><div class="complaint-notes"><p><strong>(*) Reclamo:</strong> Disconformidad relacionada a los productos o servicios.</p><p><strong>(*) Queja:</strong> Disconformidad no relacionada a los productos o servicios; o malestar o descontento respecto a la atención al público.</p><p>Conforme a la normativa vigente del Libro de Reclamaciones (Ley N.º 29571), los usuarios de DormyTop tienen a su disposición esta plataforma virtual para presentar cualquier reclamo o queja relacionado con productos o servicios adquiridos en el sitio web.</p></div><button type="submit">Enviar</button><p class="form-status" role="status">El registro será habilitado al conectar el formulario con el servicio de pedidos/reclamos.</p></form></section>}
  {!['preguntas-frecuentes', 'politica-de-devoluciones-y-reembolsos', 'politica-de-privacidad', 'libro-de-reclamaciones'].includes(slug) && <a href="/" class="back">← Volver al inicio</a>}
</main>}<Footer /></BaseLayout>
<style>
  .info-page{min-height:54vh;max-width:900px;margin:0 auto;padding:100px 25px}.info-page>p:first-child{margin:0 0 10px;color:#d9324a;font-size:12px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.info-page h1{margin:0;color:#172844;font-size:clamp(36px,6vw,62px);letter-spacing:-.05em}.lead{max-width:680px;margin:24px 0 32px;color:#526885;font-size:18px;line-height:1.7}.back{display:inline-block;padding:13px 19px;border-radius:7px;color:#fff;background:#172844;font-weight:700;text-decoration:none}.back:hover{background:#d9324a}
  .faq-list{border-top:1px solid #e2e8f0}.faq-list details{border-bottom:1px solid #e2e8f0}.faq-list summary{display:flex;padding:24px 0;justify-content:space-between;cursor:pointer;color:#172844;font-size:18px;font-weight:800}.faq-list summary::-webkit-details-marker{display:none}.faq-list summary span{color:#d9324a;font-size:22px}.faq-list details[open] summary span{transform:rotate(45deg)}.faq-list p{margin:0 0 24px;color:#526885;line-height:1.7}.legal-content{max-width:100%;color:#526885;font-size:16px;line-height:1.65}.legal-content p{margin:0 0 22px}.legal-content h2{margin:34px 0 12px;color:#172844;font-size:20px}.legal-content ul,.legal-content ol{margin:0 0 22px;padding-left:25px}.legal-content li{margin:7px 0}@media(max-width:650px){.info-page{padding:60px 20px}.lead{font-size:16px}.faq-list summary{font-size:16px}.legal-content{font-size:15px}}
  .complaint-company{margin:42px 0 70px;color:#526885}.complaint-form{max-width:1200px}.complaint-form fieldset{margin:0 0 35px;padding:0;border:0}.complaint-form legend{margin-bottom:35px;color:#526885;font-size:20px;font-weight:800}.form-grid{display:grid;gap:20px;margin-bottom:20px}.form-grid.two{grid-template-columns:1fr 1fr}.form-grid.three{grid-template-columns:repeat(3,1fr)}.complaint-form label{display:grid;gap:9px;margin-bottom:20px;color:#172844;font-size:16px}.complaint-form b{color:#d9324a}.complaint-form input,.complaint-form select,.complaint-form textarea{width:100%;padding:14px 17px;border:1px solid #d7dce3;border-radius:8px;color:#172844;background:#fff;font:inherit}.complaint-form textarea{resize:vertical}.complaint-form .consent{display:block;margin:5px 0 27px;color:#172844}.consent a{color:#d9324a}.complaint-notes{margin:0 0 30px;color:#526885;line-height:1.6}.complaint-notes p{margin:10px 0}.complaint-form button{display:block;margin:0 auto;padding:14px 30px;border:0;border-radius:8px;color:#fff;background:#d9324a;font:inherit;font-weight:800}.form-status{margin:14px auto 0;text-align:center;color:#68788f;font-size:13px}@media(max-width:650px){.info-page{padding:60px 20px}.lead{font-size:16px}.faq-list summary{font-size:16px}.legal-content{font-size:15px}.complaint-company{margin:30px 0 42px}.form-grid.two,.form-grid.three{grid-template-columns:1fr}.complaint-form legend{margin-bottom:24px}}
</style>
