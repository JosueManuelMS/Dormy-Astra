---
import site from '../data/site.json';
const about = site.about;
---
<section class="about" aria-labelledby="about-heading">
  <div class="about-copy"><p class="eyebrow">{about.eyebrow}</p><h2 id="about-heading">{about.title}</h2><p>{about.text}</p><a href={about.link}>{about.linkLabel} <span>→</span></a></div>
  <div class="about-brand"><img src={about.image} alt="Conoce DormyTop" /></div>
  <ul>{about.benefits.map((benefit) => <li>{benefit}</li>)}</ul>
</section>
<style>
  .about{display:grid;grid-template-columns:1fr 230px 1.55fr;gap:40px;max-width:1120px;margin:0 auto;padding:70px 24px;align-items:center}.eyebrow{margin:0 0 9px;color:#d9324a;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.about h2{margin:0 0 12px;color:#172844;font-size:34px;letter-spacing:-.04em}.about-copy>p:not(.eyebrow){margin:0 0 21px;color:#61718a;line-height:1.6}.about-copy a{display:inline-flex;padding:12px 17px;gap:18px;align-items:center;border-radius:999px;color:#fff;background:#172844;font-weight:700;text-decoration:none}.about-brand{display:grid;aspect-ratio:1;place-items:center;overflow:hidden;background:#e90021}.about-brand img{width:100%;height:100%;object-fit:cover}.about ul{margin:0;padding:0;list-style:none;color:#506a8b;line-height:1.65}.about li{position:relative;padding:0 0 9px 21px}.about li:before{position:absolute;left:2px;content:'•';color:#d9324a;font-weight:900}@media(max-width:720px){.about{grid-template-columns:1fr 1fr;gap:22px;padding:48px 23px}.about-copy{grid-column:1/-1}.about h2{font-size:31px}.about-brand{align-self:stretch}.about ul{font-size:14px}.about li{padding-left:15px}}
</style>
