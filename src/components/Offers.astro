---
import productData from '../data/products.json';
const legacyProducts = [
  { name: 'Cabecera Abanico', category: 'Rayadas', price: 'S/ 200.00', image: '/images/ca_abanico-600x600.webp', colors: [] },
  { name: 'Cama Mariposa', category: 'Colección Kids', price: 'S/ 1,400.00', image: '/images/cama_mariposa-600x600.webp', colors: ['#aaa69c','#92929a','#d4d5d2','#303030','#cac5ba','#c1bbb0','#c5bfb4','#55555a'] },
  { name: 'Cama Lineal', category: 'Colección Bloque', price: 'S/ 1,100.00', image: '/images/cama_lineal-600x600.webp', colors: ['#b7b4aa','#92929a','#d4d5d2','#303030','#cac5ba','#c1bbb0','#c5bfb4','#55555a'] },
  { name: 'Cama Cadena 2', category: 'Colección Bloque', price: 'S/ 1,100.00', image: '/images/cama_cadena2-600x600.webp', colors: ['#b7b4aa','#92929a','#d4d5d2','#303030','#cac5ba','#c1bbb0','#c5bfb4','#55555a'] },
];
const products = productData.products.filter((product) => product.featured).map((product) => ({ ...product, colors: [] }));
---
<section class="offers" aria-labelledby="offers-heading">
  <div class="offers-head"><p>Selección DormyTop</p><h2 id="offers-heading">Las mejores ofertas</h2><a href="/tienda">Ver todo</a></div>
  <div class="offers-rail">
    {products.map((product) => <article class="product-card">
      <a href={`/producto/${product.slug}/`} class="product-image"><img src={product.image} alt={product.name} loading="lazy" /></a>
      <div class="product-details">
        <span class="measure">⌑&nbsp; 1.5 Plz · 2 Plz · Queen · King</span>
        <p class="category">{product.category}</p><h3>{product.name}</h3><p class="price">{product.price}</p>
        {product.colors.length > 0 && <div class="colors" aria-label="Colores disponibles">{product.colors.slice(0, 5).map((color, index) => <span class:list={['swatch', { selected: index === 0 }]} style={`--swatch:${color}`}></span>)}<span class="more-colors">+{product.colors.length - 5}</span></div>}
        <a href="#" class="model-button">Ver modelos <span>→</span></a>
      </div>
    </article>)}
  </div>
</section>

<style>
  .offers{padding:74px max(24px,calc((100vw - 1720px)/2));background:#fff}.offers-head{display:grid;grid-template-columns:1fr auto 1fr;align-items:end;margin:0 0 30px}.offers-head p{grid-column:2;margin:0 0 7px;color:#d9324a;font-size:12px;font-weight:700;letter-spacing:.12em;text-align:center;text-transform:uppercase}.offers-head h2{grid-column:2;margin:0;color:#172844;font-size:40px;letter-spacing:-.045em}.offers-head a{grid-column:3;justify-self:end;color:#172844;font-size:14px;font-weight:700;text-decoration:none}.offers-rail{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}.product-card{min-width:0}.product-image{display:block;overflow:hidden;background:#f7f5f2;aspect-ratio:1/1}.product-image img{width:100%;height:100%;object-fit:cover;transition:transform .25s ease}.product-image:hover img{transform:scale(1.03)}.product-details{padding:13px 0 0}.measure{display:inline-block;max-width:100%;padding:6px 9px;border-radius:4px;color:#40516a;background:#f4f5f7;font-size:11px;line-height:1.35}.category{margin:12px 0 4px;color:#94a1b3;font-size:13px}.product-card h3{margin:0;color:#172844;font-size:16px}.price{margin:7px 0 12px;color:#496582;font-size:16px;font-weight:700}.colors{display:flex;height:30px;margin:0 0 15px;align-items:center;gap:8px}.swatch{display:block;width:24px;height:24px;border:1px solid rgba(0,0,0,.12);border-radius:50%;background:var(--swatch)}.swatch.selected{outline:2px solid #172844;outline-offset:2px}.more-colors{color:#68788f;font-size:12px;font-weight:700}.model-button{display:flex;min-height:42px;padding:0 17px;align-items:center;justify-content:space-between;color:#fff;background:#172844;font-size:13px;font-weight:700;letter-spacing:.04em;text-decoration:none;text-transform:uppercase;transition:background .2s}.model-button:hover{background:#d9324a}.model-button span{font-size:18px}@media(max-width:720px){.offers{padding:46px 0 52px}.offers-head{grid-template-columns:1fr auto;padding:0 23px;margin-bottom:22px}.offers-head p{grid-column:1;margin-bottom:5px;text-align:left}.offers-head h2{grid-column:1;font-size:32px}.offers-head a{grid-column:2;grid-row:1/3}.offers-rail{display:flex;padding:0 23px 12px;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}.offers-rail::-webkit-scrollbar{display:none}.product-card{flex:0 0 min(78vw,310px);scroll-snap-align:start}.product-details{padding-top:12px}.measure{font-size:11px}.product-card h3{font-size:17px}.model-button{min-height:44px}.colors{margin-bottom:14px}}
</style>
