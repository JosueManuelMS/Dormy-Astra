<aside class="cart-drawer" data-cart-drawer aria-hidden="true">
  <div class="drawer-head"><h2>Tu carrito</h2><button type="button" data-cart-close aria-label="Cerrar carrito">×</button></div>
  <div class="drawer-item" data-drawer-item><img src="/images/cama_lineal-600x600.webp" alt="Cama Lineal" /><div><h3>Cama Lineal</h3><p><b>Medida:</b> 2 Plazas <b>Color:</b> Coral Camel</p><strong>Precio: S/ 1,100.00</strong><div class="quantity"><button type="button" data-quantity="-" aria-label="Reducir cantidad">−</button><span data-quantity-value>1</span><button type="button" data-quantity="+" aria-label="Aumentar cantidad">+</button></div></div><button class="remove" type="button" data-remove-product aria-label="Quitar Cama Lineal"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M10 11v6m4-6v6M9 7l1-3h4l1 3m-9 0 1 13h10l1-13" /></svg></button></div>
  <div class="drawer-empty" data-drawer-empty hidden><strong>Tu carrito está vacío</strong><p>Explora nuestros modelos para encontrar tu dormitorio ideal.</p><button type="button" data-cart-close>Continuar comprando</button></div>
  <div class="drawer-foot" data-drawer-foot><strong>Subtotal: S/ 1,100.00</strong><p>Los gastos de envío, impuestos y descuentos se calculan al finalizar la compra.</p><div><a href="/carrito/">Ver carrito</a><button type="button" data-cart-close>Continuar comprando</button></div><a class="checkout" href="/finalizar-compra/">Finalizar compra</a></div>
</aside>
<button class="cart-shade" type="button" data-cart-close hidden aria-label="Cerrar carrito"></button>
<script>
  const drawer = document.querySelector('[data-cart-drawer]');
  const shade = document.querySelector('.cart-shade');
  const setDrawer = (open) => { drawer?.classList.toggle('open', open); drawer?.setAttribute('aria-hidden', String(!open)); if (shade) shade.hidden = !open; document.body.classList.toggle('drawer-lock', open); };
  document.querySelectorAll('[data-cart-trigger]').forEach((element) => element.addEventListener('click', (event) => { event.preventDefault(); setDrawer(true); }));
  document.querySelectorAll('[data-cart-close]').forEach((element) => element.addEventListener('click', () => setDrawer(false)));
  document.querySelectorAll('[data-quantity]').forEach((element) => element.addEventListener('click', () => { const output = document.querySelector('[data-quantity-value]'); if (output) output.textContent = String(Math.max(1, Number(output.textContent) + (element.dataset.quantity === '+' ? 1 : -1))); }));
  document.querySelector('[data-remove-product]')?.addEventListener('click', () => { document.querySelector('[data-drawer-item]')?.setAttribute('hidden', ''); document.querySelector('[data-drawer-foot]')?.setAttribute('hidden', ''); document.querySelector('[data-drawer-empty]')?.removeAttribute('hidden'); });
</script>
<style>
  .cart-drawer{position:fixed;top:0;right:0;z-index:100;width:min(510px,100vw);height:100dvh;display:flex;flex-direction:column;color:#111;background:#f7f8fa;box-shadow:-18px 0 50px #0003;transform:translateX(105%);transition:transform .25s}.cart-drawer.open{transform:none}.drawer-head{display:flex;padding:24px 28px;align-items:center;justify-content:space-between;background:#fff;border-bottom:1px solid #e6e8ec}.drawer-head h2{margin:0;font-size:28px}.drawer-head button{border:0;background:none;font-size:36px}.drawer-item{position:relative;display:grid;grid-template-columns:110px 1fr;gap:18px;margin:16px;padding:18px;background:#fff;border-radius:8px;box-shadow:0 3px 10px #1828440d}.drawer-item img{width:110px;height:110px;object-fit:contain}.drawer-item h3{margin:0 0 10px}.drawer-item p{margin:0 0 10px;line-height:1.5}.quantity{display:flex;width:max-content;margin-top:14px;border:1px solid #cfd6df}.quantity button,.quantity span{width:34px;height:34px;display:grid;place-items:center;border:0;background:#fff;font:inherit}.quantity span{border-inline:1px solid #cfd6df}.remove{position:absolute;top:15px;right:14px;display:grid;width:32px;height:32px;padding:0;place-items:center;border:0;background:none;color:#101820;cursor:pointer}.remove svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.remove:hover{color:#d9324a}.drawer-empty{padding:42px 30px;text-align:center}.drawer-empty strong{font-size:20px}.drawer-empty p{color:#60708a;line-height:1.5}.drawer-empty button{padding:12px 16px;border:1px solid #d5dce4;border-radius:6px;background:#fff;font:inherit}.drawer-foot{margin-top:auto;padding:24px;background:#fff;border-top:1px solid #e4e6eb;text-align:center}.drawer-foot>strong{font-size:22px}.drawer-foot p{line-height:1.5}.drawer-foot>div{display:grid;grid-template-columns:1fr 1fr;gap:8px}.drawer-foot a,.drawer-foot button{padding:13px;border:1px solid #d5dce4;border-radius:6px;color:#111;background:#fff;font:inherit;text-decoration:none}.drawer-foot .checkout{display:block;margin-top:8px;color:#fff;background:#d9324a;border-color:#d9324a}.cart-shade{position:fixed;inset:0;z-index:99;border:0;background:#0009}@media(max-width:600px){.drawer-head{padding:20px}.drawer-item{grid-template-columns:92px 1fr;margin:12px;padding:14px}.drawer-item img{width:92px;height:92px}.drawer-item h3{font-size:18px}.drawer-foot{padding:20px 15px}}
</style>
