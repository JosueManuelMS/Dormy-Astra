<aside class="cart-drawer" data-cart-drawer aria-hidden="true"><div class="drawer-head"><h2>Tu carrito</h2><button data-cart-close aria-label="Cerrar carrito">×</button></div><div class="drawer-item"><img src="/images/cama_lineal-600x600.webp" alt="Cama Lineal" /><div><h3>Cama Lineal</h3><p><b>Medida:</b> 2 Plazas <b>Color:</b> Coral Camel</p><strong>Precio: S/ 1,100.00</strong><div class="quantity"><button data-quantity="-">−</button><span data-quantity-value>1</span><button data-quantity="+">+</button></div></div><button class="remove" aria-label="Quitar producto">⌫</button></div><div class="drawer-foot"><strong>Subtotal: S/ 1,100.00</strong><p>Los gastos de envío, impuestos y descuentos se calculan al finalizar la compra.</p><div><a href="/carrito/">Ver carrito</a><button data-cart-close>Continuar comprando</button></div><a class="checkout" href="/finalizar-compra/">Finalizar compra</a></div></aside><button class="cart-shade" data-cart-close hidden aria-label="Cerrar carrito"></button>
<script>
  const drawer=document.querySelector('[data-cart-drawer]'), shade=document.querySelector('.cart-shade'); const setDrawer=(open)=>{drawer?.classList.toggle('open',open);drawer?.setAttribute('aria-hidden',String(!open));if(shade)shade.hidden=!open;document.body.classList.toggle('drawer-lock',open)};document.querySelectorAll('[data-cart-trigger]').forEach(el=>el.addEventListener('click',e=>{e.preventDefault();setDrawer(true)}));document.querySelectorAll('[data-cart-close]').forEach(el=>el.addEventListener('click',()=>setDrawer(false)));document.querySelectorAll('[data-quantity]').forEach(el=>el.addEventListener('click',()=>{const output=document.querySelector('[data-quantity-value]');output.textContent=Math.max(1,+output.textContent+(el.dataset.quantity==='+'?1:-1));}));
</script>
<style>.cart-drawer{position:fixed;top:0;right:0;z-index:100;width:min(510px,100vw);height:100dvh;display:flex;flex-direction:column;color:#111;background:#f7f8fa;box-shadow:-18px 0 50px #0003;transform:translateX(105%);transition:transform .25s}.cart-drawer.open{transform:none}.drawer-head{display:flex;padding:24px 28px;align-items:center;justify-content:space-between;background:#fff;border-bottom:1px solid #e6e8ec}.drawer-head h2{margin:0;font-size:28px}.drawer-head button{border:0;background:none;font-size:36px}.drawer-item{position:relative;display:grid;grid-template-columns:110px 1fr;gap:18px;margin:16px;padding:18px;background:#fff;border-radius:8px;box-shadow:0 3px 10px #1828440d}.drawer-item img{width:110px;height:110px;object-fit:contain}.drawer-item h3{margin:0 0 10px}.drawer-item p{margin:0 0 10px;line-height:1.5}.quantity{display:flex;width:max-content;margin-top:14px;border:1px solid #cfd6df}.quantity button,.quantity span{width:34px;height:34px;display:grid;place-items:center;border:0;background:#fff;font:inherit}.quantity span{border-inline:1px solid #cfd6df}.remove{position:absolute;top:15px;right:14px;border:0;background:none;font-size:23px}.drawer-foot{margin-top:auto;padding:24px;background:#fff;border-top:1px solid #e4e6eb;text-align:center}.drawer-foot>strong{font-size:22px}.drawer-foot p{line-height:1.5}.drawer-foot>div{display:grid;grid-template-columns:1fr 1fr;gap:8px}.drawer-foot a,.drawer-foot button{padding:13px;border:1px solid #d5dce4;border-radius:6px;color:#111;background:#fff;font:inherit;text-decoration:none}.drawer-foot .checkout{display:block;margin-top:8px;color:#fff;background:#d9324a;border-color:#d9324a}.cart-shade{position:fixed;inset:0;z-index:99;border:0;background:#0009}@media(max-width:600px){.drawer-head{padding:20px}.drawer-item{grid-template-columns:92px 1fr;margin:12px;padding:14px}.drawer-item img{width:92px;height:92px}.drawer-item h3{font-size:18px}.drawer-foot{padding:20px 15px}}</style>
